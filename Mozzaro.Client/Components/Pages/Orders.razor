@page "/orders"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Mozzaro.Client.Services

@inject HttpClient HttpClient
@inject NavigationManager Navigation
@inject UserSessionService UserSession

<PageTitle>Мои заказы — Mozzaro</PageTitle>

<div class="orders-page">
    <div class="orders-header">
        <span class="orders-label">MOZZARO</span>

        <h1>мои заказы</h1>

        <p>
            здесь вы можете посмотреть историю своих заказов
        </p>
    </div>

    @if (IsLoading)
    {
        <div class="orders-state">
            <div class="loading-spinner"></div>
            <p>загружаем заказы...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="orders-state error-state">
            <div class="state-icon">!</div>

            <h2>не удалось загрузить заказы</h2>

            <p>@ErrorMessage</p>

            <button class="retry-button" @onclick="LoadOrdersAsync">
                попробовать снова
            </button>
        </div>
    }
    else if (OrderList.Count == 0)
    {
        <div class="orders-state empty-state">
            <div class="state-icon">🛒</div>

            <h2>у вас пока нет заказов</h2>

            <p>
                выберите любимую пиццу в меню и оформите свой первый заказ
            </p>

            <button class="menu-button" @onclick="GoToMenu">
                перейти в меню
            </button>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var order in OrderList)
            {
                <article class="order-card">
                    <div class="order-card-header">
                        <div class="order-number">
                            <span>заказ</span>
                            <strong>#@order.Id</strong>
                        </div>

                        <div class="order-date">
                            @(order.CreatedAt
                                .ToLocalTime()
                                .ToString("dd.MM.yyyy HH:mm"))
                        </div>

                        <div class="order-status">
                            @GetStatusText(order.Status)
                        </div>
                    </div>

                    <div class="order-address">
                        <span class="address-icon">⌖</span>

                        <div>
                            <span class="address-label">
                                адрес доставки
                            </span>

                            <span class="address-value">
                                @order.DeliveryAddress
                            </span>
                        </div>
                    </div>

                    <div class="order-items">
                        @foreach (var item in order.Items)
                        {
                            <div class="order-item">
                                <div class="pizza-image-wrapper">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img
                                            src="@item.ImageUrl"
                                            alt="@item.PizzaName"
                                            class="pizza-image" />
                                    }
                                    else
                                    {
                                        <div class="pizza-placeholder">
                                            🍕
                                        </div>
                                    }
                                </div>

                                <div class="pizza-info">
                                    <span class="pizza-name">
                                        @item.PizzaName
                                    </span>

                                    <span class="pizza-quantity">
                                        @item.Quantity ×
                                        @item.Price.ToString("0.00") €
                                    </span>
                                </div>

                                <div class="pizza-total">
                                    @((item.Price * item.Quantity).ToString("0.00")) €
                                </div>
                            </div>
                        }
                    </div>

                    <div class="order-footer">
                        <span class="total-label">
                            итого
                        </span>

                        <strong class="total-price">
                            @order.TotalPrice.ToString("0.00") €
                        </strong>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<OrderResponse> OrderList { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            if (!UserSession.IsAuthenticated ||
                !UserSession.UserId.HasValue)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var userId = UserSession.UserId.Value;

            var orders = await HttpClient.GetFromJsonAsync<
                List<OrderResponse>>(
                $"api/Order/user/{userId}");

            OrderList = orders ?? new List<OrderResponse>();
        }
        catch
        {
            ErrorMessage = "не удалось подключиться к серверу.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoToMenu()
    {
        Navigation.NavigateTo("/menu");
    }

    private static string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "в обработке",
            "Confirmed" => "подтверждён",
            "Preparing" => "готовится",
            "Ready" => "готов",
            "Delivered" => "доставлен",
            "Cancelled" => "отменён",
            _ => status
        };
    }

    private class OrderResponse
    {
        public int Id { get; set; }

        public string Status { get; set; } = string.Empty;

        public decimal TotalPrice { get; set; }

        public DateTime CreatedAt { get; set; }

        public string DeliveryAddress { get; set; } = string.Empty;

        public List<OrderItemResponse> Items { get; set; } = new();
    }

    private class OrderItemResponse
    {
        public int PizzaId { get; set; }

        public string PizzaName { get; set; } = string.Empty;

        public string? ImageUrl { get; set; }

        public int Quantity { get; set; }

        public decimal Price { get; set; }
    }
}