@rendermode InteractiveServer
@using Mozzaro.Client.Services

@inject UserSessionService UserSession
@inject NavigationManager Navigation

<div class="mozzaro-sidebar">

    <div class="mozzaro-brand">

        <a href="/" class="mozzaro-logo-link">
            <img src="/images/logo.png"
                 alt="Mozzaro Pizzeria"
                 class="mozzaro-logo" />
        </a>

    </div>

    <nav class="mozzaro-navigation">

        <NavLink class="mozzaro-nav-link"
                 href=""
                 Match="NavLinkMatch.All">

            <span class="nav-icon">⌂</span>
            <span>Главная</span>

        </NavLink>

        <NavLink class="mozzaro-nav-link"
                 href="menu">

            <span class="nav-icon">◉</span>
            <span>Меню</span>

        </NavLink>

        <NavLink class="mozzaro-nav-link"
                 href="cart">

            <span class="nav-icon">🛒</span>
            <span>Корзина</span>

        </NavLink>

        @if (UserSession.IsAuthenticated)
        {
            <NavLink class="mozzaro-nav-link"
                     href="orders">

                <span class="nav-icon">▤</span>
                <span>Мои заказы</span>

            </NavLink>

            <div class="mozzaro-user-section">

                <div class="mozzaro-user">

                    <span class="nav-icon">♙</span>

                    <div class="user-info">

                        <span class="user-label">
                            вы вошли как
                        </span>

                        <span class="user-name">
                            @UserSession.UserName
                        </span>

                    </div>

                </div>

                <button type="button"
                        class="mozzaro-logout-button"
                        @onclick="Logout">

                    <span class="nav-icon">↪</span>
                    <span>Выйти</span>

                </button>

            </div>
        }
        else
        {
            <NavLink class="mozzaro-nav-link"
                     href="login">

                <span class="nav-icon">♙</span>
                <span>Войти</span>

            </NavLink>

            <NavLink class="mozzaro-nav-link"
                     href="register">

                <span class="nav-icon">＋</span>
                <span>Регистрация</span>

            </NavLink>
        }

    </nav>

    <div class="mozzaro-sidebar-footer">

        <div class="footer-line"></div>

        <span class="footer-label">
            ITALIAN TASTE
        </span>

        <span class="footer-label">
            EVERYDAY
        </span>

        <div class="italian-colors">

            <span class="green"></span>
            <span class="white"></span>
            <span class="red"></span>

        </div>

        <div class="sidebar-message">

            <span class="message-icon">🍴</span>

            <span>
                Хорошая пицца<br />
                делает день лучше
            </span>

            <span class="heart">♥</span>

        </div>

    </div>

</div>

@implements IDisposable

@code {

    protected override void OnInitialized()
    {
        UserSession.OnChange += OnUserSessionChanged;
    }

    private void OnUserSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        UserSession.Logout();

        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        UserSession.OnChange -= OnUserSessionChanged;
    }
}