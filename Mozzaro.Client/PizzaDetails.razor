@page "/pizza/{id:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Mozzaro.Domain.Entities
@using Mozzaro.Client.Services

@rendermode InteractiveServer

@inject PizzaApiService PizzaApiService
@inject CartService CartService

<PageTitle>Пицца — Mozzaro</PageTitle>

<div class="pizza-details-page">

    @if (isLoading)
    {
        <div class="pizza-details-loading">
            Загружаем пиццу...
        </div>
    }
    else if (pizza == null)
    {
        <div class="pizza-details-empty">

            <h1>
                Пицца не найдена
            </h1>

            <p>
                Возможно, эта пицца больше недоступна.
            </p>

            <a href="/menu"
               class="back-button">
                Вернуться в меню
            </a>

        </div>
    }
    else
    {
        <div class="pizza-details">

            <div class="pizza-details-image">

                @if (!string.IsNullOrWhiteSpace(pizza.ImageUrl))
                {
                    <div class="pizza-photo">

                        <img src="@pizza.ImageUrl"
                             alt="@pizza.Name" />

                    </div>
                }
                else
                {
                    <div class="pizza-photo pizza-placeholder">
                        🍕
                    </div>
                }

            </div>

            <div class="pizza-details-content">

                <span class="pizza-details-label">
                    MOZZARO
                </span>

                <h1>
                    @pizza.Name
                </h1>

                <p class="pizza-details-description">
                    @(string.IsNullOrWhiteSpace(pizza.Description)
                        ? "Вкусная пицца Mozzaro."
                        : pizza.Description)
                </p>

                <div class="pizza-details-price">
                    @pizza.Price.ToString("0.00") €
                </div>

                <div class="pizza-details-status">

                    @if (pizza.IsAvailable)
                    {
                        <span class="available">
                            В наличии
                        </span>
                    }
                    else
                    {
                        <span class="unavailable">
                            Нет в наличии
                        </span>
                    }

                </div>

                <div class="pizza-details-actions">

                    @if (pizza.IsAvailable)
                    {
                        <button class="add-to-cart-button"
                                @onclick="AddToCart">
                            В корзину
                        </button>
                    }

                    <a href="/menu"
                       class="back-link">
                        ← Вернуться в меню
                    </a>

                </div>

            </div>

        </div>
    }

</div>

@if (showCartNotification)
{
    <div class="cart-toast">

        <div class="cart-toast-icon">
            ✓
        </div>

        <div class="cart-toast-content">
            <strong>
                Добавлено в корзину
            </strong>

            <span>
                @notificationPizzaName
            </span>
        </div>

        <a href="/cart"
           class="cart-toast-button">
            Корзина →
        </a>

        <button class="cart-toast-close"
                @onclick="HideNotification">
            ×
        </button>

    </div>
}

@code {

    [Parameter]
    public int id { get; set; }

    private Pizza? pizza;

    private bool isLoading = true;

    private bool showCartNotification;

    private string notificationPizzaName = string.Empty;

    private CancellationTokenSource? notificationCts;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            pizza = await PizzaApiService.GetPizzaByIdAsync(id);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task AddToCart()
    {
        if (pizza == null)
            return;

        CartService.Add(pizza);

        notificationPizzaName = pizza.Name;
        showCartNotification = true;

        notificationCts?.Cancel();
        notificationCts?.Dispose();

        notificationCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(3500, notificationCts.Token);

            showCartNotification = false;

            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }


    private void HideNotification()
    {
        notificationCts?.Cancel();

        showCartNotification = false;
    }


    public void Dispose()
    {
        notificationCts?.Cancel();
        notificationCts?.Dispose();
    }

}